rules_version = '2';

// ─────────────────────────────────────────────────────────────────────
//  MERGE INTO YOUR EXISTING STORAGE RULES — DO NOT BLINDLY REPLACE
//
//  Publish at:
//  console.firebase.google.com → Storage → Rules → Publish
//
//  There is no catch-all deny at the bottom on purpose: adding one would
//  silently revoke access to anything else already in this bucket.
//  Firebase denies unmatched paths by default anyway.
// ─────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    // Path shape: wishes/{retention}/{wishId}/{n}.bin
    //
    // The retention class sits in the path so that Cloud Storage lifecycle
    // rules can expire each class on its own schedule (see README). A single
    // bucket-wide rule could only ever enforce one window for everybody.
    //
    // These objects are AES-GCM ciphertext, not images — the key never
    // leaves the sender's browser. Anyone who fetches one without the key
    // gets meaningless bytes, so public read costs nothing here. The
    // content type cannot be validated for the same reason.
    match /wishes/{retention}/{wishId}/{fileName} {
      allow read: if true;

      allow create: if request.resource.size < 4 * 1024 * 1024
                    && retention in ['24h', '7d', '30d', 'forever'];

      allow update, delete: if false;
    }
  }
}
